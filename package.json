{
  "name": "resonance-field",
  "private": true,
  "version": "1.0.0",
  "description": "《共振场：听见深海》—— 基于网格 BFS 声波传播的 2D 空间感知益智游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "esbuild scripts/validateLevels.ts --bundle --platform=node --format=esm --outfile=.tmp/validateLevels.mjs --log-level=warning && node .tmp/validateLevels.mjs",
    "emit-keys": "esbuild scripts/emitKeys.ts --bundle --platform=node --format=esm --outfile=.tmp/emitKeys.mjs --log-level=warning && node .tmp/emitKeys.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.64.5",
    "@esbuild/linux-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.64.5"
  }
}
